# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Public production address used for verification and password-reset email links
APP_URL=https://www.jverse.site

# Contact form email delivery (use a Google App Password for Gmail)
CONTACT_RECIPIENT_EMAIL=jaybe.gubot01@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jaybe.gubot01@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=jaybe.gubot01@gmail.com


# Node Environment
NODE_ENV=development

# Port
PORT=3000
